{
  "name": "crypto-valuation-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "snapshot:capture": "tsx scripts/capture-snapshot.ts",
    "snapshot:shadow": "tsx scripts/shadow-pipeline.ts",
    "snapshot:replay": "tsx scripts/replay-source-bundle.ts",
    "test:deploy-preflight": "node --test scripts/deploy-contract.test.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "verify:local": "npm run deploy:preflight && npm run test:deploy-preflight && npm test && npm run typecheck && npm run build && git diff --check",
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "verify:production": "node scripts/verify-production.mjs && npm run audit:coverage",
    "deploy:production": "node scripts/deploy-production.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
